global:
  scrape_interval: ${PROMETHEUS_SCRAPE_INTERVAL}

external_labels:
  monitoring_profile: load-test

scrape_configs:
  - job_name: fast-pass-app
    metrics_path: /metrics
    static_configs:
      - targets: ['${APP_TARGET}']

  - job_name: fast-pass-pm2
    metrics_path: /metrics
    static_configs:
      - targets: ['${PM2_METRICS_TARGET}']
